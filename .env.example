# Copia este archivo como .env y cambia los valores. El archivo .env NO se versiona.
# docker compose los usa para prestalab-db (POSTGRES_*) y prestalab-app (SPRING_DATASOURCE_* y PRESTALAB_JWT_SECRET).
POSTGRES_USER=prestalab
POSTGRES_PASSWORD=cambia-esta-clave
# Secreto para firmar los JWT (HS256, al menos 32 bytes). Genera uno propio con:
#   openssl rand -base64 48
PRESTALAB_JWT_SECRET=cambia-este-secreto-por-uno-generado-con-openssl
