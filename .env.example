# Copia este archivo como .env y cambia los valores. El archivo .env NO se versiona.
# docker compose los usa para prestalab-db (usuario raíz de MongoDB) y prestalab-app (SPRING_DATA_MONGODB_URI y
# PRESTALAB_JWT_SECRET). La contraseña va dentro de la URI de conexión: usa solo letras, números, - y _.
MONGO_USER=prestalab
MONGO_PASSWORD=cambia-esta-clave
# Secreto para firmar los JWT (HS256, al menos 32 bytes). Va vacío a propósito: docker compose no arranca hasta que
# pongas uno propio, así nunca se usa un secreto público. Genéralo con:
#   openssl rand -base64 48
PRESTALAB_JWT_SECRET=
